<manifest xmlns:android="http://schemas.android.com/apk/res/android">
 <application android:label="PurrView" android:icon="@mipmap/ic_launcher" android:roundIcon="@mipmap/ic_launcher_round" android:allowBackup="false" android:theme="@android:style/Theme.Material.Light.NoActionBar" android:supportsRtl="true">
  <activity android:name=".MainActivity" android:exported="true">
   <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
  </activity>
  <service android:name=".WebpDecodeService"
      android:process=":webp_decoder"
      android:exported="false"
      android:stopWithTask="true" />
  <service android:name=".JpegDecodeService"
      android:process=":jpeg_decoder"
      android:exported="false"
      android:stopWithTask="true" />
  <service android:name=".PngDecodeService"
      android:process=":png_decoder"
      android:exported="false"
      android:stopWithTask="true" />
  <service android:name=".SmsDecodeService"
      android:process=":sms_decoder"
      android:exported="false"
      android:stopWithTask="true" />
  <!-- Bounded, demo-only trigger for tools/ai_mutate.py sweep mode: no data
       from the incoming broadcast is used, it only starts PngDecodeService
       against PurrView's own already-private files/purrview-ai.png, and it is
       a no-op unless the installed build is itself debuggable (see
       AiSweepReceiver). -->
  <receiver android:name=".AiSweepReceiver" android:exported="true">
   <intent-filter><action android:name="lab.purrview.action.AI_SWEEP_START"/></intent-filter>
  </receiver>
  <!-- Bounded, demo-only triggers for tools/purr_agent.py's live methods: the
       ASLR self-check (logs PurrView/ASLR from the main process) and the R/W
       primitive against the already-private files/purrview-rw.png. Neither
       takes an arbitrary path/offset/payload from the broadcast, and both are
       a no-op unless the installed build is itself debuggable (see
       LabControlReceiver). -->
  <receiver android:name=".LabControlReceiver" android:exported="true">
   <intent-filter>
    <action android:name="lab.purrview.action.ASLR_SELFCHECK"/>
    <action android:name="lab.purrview.action.RW_START"/>
   </intent-filter>
  </receiver>
 </application>
</manifest>
